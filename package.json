{
  "name": "open-space-pass-tactics-board",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "초등 3~6학년 체육 '빈 공간 패스' 전술판 학습 앱. 고정된 검수 미션에서 패스 길과 지원 위치를 공간 근거로 판단한다.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run src tests/privacy",
    "test:a11y": "vitest run tests/a11y",
    "test:release": "vitest run tests/release",
    "test:e2e": "playwright test",
    "check:lines": "node scripts/check-file-lines.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run test:a11y && npm run check:lines && npm run build && npm run test:release && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.10.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "vitest-axe": "1.0.0-pre.5"
  }
}
